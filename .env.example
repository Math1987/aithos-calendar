# Optional local credentials only. Prefer AWS_PROFILE=aithos-prod after SSO login.
AWS_ACCESS_KEY_ID=example
AWS_SECRET_ACCESS_KEY=example
AWS_SESSION_TOKEN=example
AWS_DEFAULT_REGION=eu-west-3
GH_TOKEN=example

# Booking adapter: server-side only; never expose these in the website.
ANAKIN_API_KEY=example
# Optional name overrides; defaults are Calendar / Guest.
# BOOKING_TEST_FIRST_NAME=Calendar
# BOOKING_TEST_LAST_NAME=Guest
# Required: replace with an inbox you control; this placeholder is rejected.
BOOKING_TEST_EMAIL=test@example.com
